# 流量保险丝配置(装到 /etc/heatmap-traffic-guard.conf)
# 改完不需要重启:下一次定时(≤1 分钟)就会用新值。
# 写法用 ${VAR:-默认值}:这样命令行/环境变量可以临时覆盖(测试用)。

# 月流量上限(MB)——按你的流量包/预算填
LIMIT_MB=${LIMIT_MB:-20480}

# 预警线:到这个量开始刷警告日志(默认 = 90% 上限)
WARN_MB=${WARN_MB:-18432}

# 熔断线:到这个量停止下面的服务,防止继续烧流量(默认 = 97.5% 上限 = 19.5G/20G)
STOP_MB=${STOP_MB:-19968}

# 熔断时停止哪些服务(按耗流量从大到小)。
# hbrclient = 阿里云云备份客户端(整机备份,一次全量就上传几个 GB)
STOP_UNITS=${STOP_UNITS:-"heatmap-api hbrclient"}

# 统计哪块网卡;auto = 出网字节最大的非 lo 网卡
IFACE=${IFACE:-auto}

# 本计费周期开始前已用掉的量(MB)。
# 校准方法:去控制台看一眼"流量包已用/出网流量",把数字抄到这里一次即可。
ALREADY_USED_MB=${ALREADY_USED_MB:-0}
